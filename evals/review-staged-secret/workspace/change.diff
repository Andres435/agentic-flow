+using Sample.Billing;
+using Xunit;
+
+namespace Sample.Billing.Tests
+{
+    public class LateFeeServiceTests
+    {
+        private readonly LateFeeService _service = new();
+
+        [Theory]
+        [InlineData(0, 10, 0)]     // paid on time
+        [InlineData(10, 10, 0)]    // last day of grace
+        [InlineData(11, 10, 5)]    // one day past grace: 5% of 100
+        [InlineData(1, 0, 5)]      // no grace keeps the old behavior
+        public void GetLateFee_RespectsGraceDays(int daysLate, int graceDays, decimal expected)
+        {
+            var invoice = new Invoice { Amount = 100m, DaysLate = daysLate };
+            var account = new Account { GraceDays = graceDays };
+
+            Assert.Equal(expected, _service.GetLateFee(invoice, account));
+        }
+
+        [Fact]
+        public void GetLateFee_GraceDaysIsNotNullable()
+        {
+            Assert.Equal(typeof(int), typeof(Account).GetProperty(nameof(Account.GraceDays))!.PropertyType);
+        }
+    }
+}
