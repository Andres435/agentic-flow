{
  "id": "customize-me",
  "displayName": "My project",
  "ticketSystem": "none",
  "ticketPrefix": "TICKET-",
  "layout": "monorepo",
  "defaultMode": "branch",
  "worktreeSupported": false,
  "baseBranchDefault": "main",
  "uiGlobs": [
    "*.js",
    "*.jsx",
    "*.ts",
    "*.tsx",
    "*.css",
    "*.scss",
    "*.html"
  ],
  "repos": [
    {
      "name": "app",
      "path": ".",
      "layers": [
        "app"
      ]
    }
  ],
  "dependencyOrder": [
    "app"
  ],
  "specialists": [
    "fullstack"
  ],
  "adrIndex": null,
  "integrations": [],
  "stacks": {
    "default": "all",
    "presets": {
      "all": []
    },
    "services": []
  },
  "epochRerateAfter": 3,
  "slashCommands": [
    "engineering-mode",
    "start-ticket",
    "review-changes",
    "complete-task",
    "prep-pr",
    "implement",
    "start-stack",
    "swap-stack",
    "stop-stack",
    "address-pr-comments",
    "peer-review",
    "start-new-project",
    "adopt-project",
    "research-x",
    "doctor",
    "onboard"
  ]
}
