# Local state files
.active-stack.json
*.state.json
.npmrc
.env.local
node_modules/

# macOS
.DS_Store

# Editor
.vscode/

# User-local ticket files. Manifests, plans, and the
# ledger belong to whoever ran the ticket and never enter git. Only the files below
# stay tracked. See _shared/ticket-artifacts.md.
plans/*
!plans/README.md
!plans/closeout-index.md
!plans/workflow-template-plan.md
!plans/examples/

# Per-app ticket files on this host. Overlays stay tracked; the ledger does not.
apps/*/plans/*

# Measured context and the one active-stack owner (dotfile on macOS and Linux).
scripts/.ctx-usage.json
scripts/.active-stack.json
# Swallowed hook errors (hooks/core/hook-log.js). /doctor warns when this is non-empty.
scripts/.hook-errors.log

# Local scratch (tmp/tickets holds cached ticket fetches and PR-body drafts), local-only
# overrides such as local-test-login.local.json, launcher logs, and Pester -CI output.
tmp/
*.local.json
*.local.md
user/external-lanes.local.json
scripts/*.log
testResults.xml
